# Copy to `.env.local` for local dev (not committed).
# Canonical URL for metadata, sitemap, OG (no trailing slash).
# In Vercel: set for Production only (e.g. https://seasonally-living.vercel.app).
# Leave unset for Preview so each deployment uses VERCEL_URL — unless you add
# the same keys for Preview in the Vercel dashboard (recommended for PR previews).
# After custom domain: set to https://yourdomain.com
# NEXT_PUBLIC_SITE_URL=https://seasonally-living.vercel.app

# Stitch (Google Stitch) — optional; for MCP / handoffs (see docs/stitch.md)
# STITCH_PROJECT_ID=13771544954940531085
# STITCH_DESIGN_SYSTEM_ASSET_ID=6269b0f19bc94dc5960be1285e8f62af

# Public contact (shown in footer, /book, /contact) — also set in Vercel
NEXT_PUBLIC_CONTACT_PHONE=(509) 667-8833
NEXT_PUBLIC_CONTACT_EMAIL=sales@seasonallyliving.com
# Optional: explicit tel href if display is not parseable (E.164)
# NEXT_PUBLIC_CONTACT_PHONE_TEL=+15096678833

# Optional: when online booking is ready (Calendly, Lightspeed, etc.)
# NEXT_PUBLIC_SCHEDULER_URL=https://...
# NEXT_PUBLIC_LEAD_FORM_URL=https://...

# ---------------------------------------------------------------------------
# Ads & analytics (TOL-3346). Everything below is OFF unless set: with none set,
# no tag script loads, no request goes to Google/Meta/PostHog and no consent
# banner shows. NEXT_PUBLIC_* values are baked in at BUILD time, so on Cloud Run
# pass them as Docker build args (see Dockerfile) and redeploy.
# ---------------------------------------------------------------------------
# Google Analytics 4 measurement ID (Admin > Data streams). Mark the six events below as key events.
# NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
# Google Ads account tag (Goals > Conversions > tag setup). Loads the remarketing tag.
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXX
# Google Ads conversion labels: the part after the slash in "AW-123456789/AbCdEf...". Set only the
# actions you created in Google Ads; an event with no label still goes to GA4 but is not an Ads conversion.
# NEXT_PUBLIC_GOOGLE_ADS_LABEL_LEAD=          # lead_submitted (visit / consult form)
# NEXT_PUBLIC_GOOGLE_ADS_LABEL_PREOWNED=      # preowned_inquiry
# NEXT_PUBLIC_GOOGLE_ADS_LABEL_CALL=          # call_click (any tel: link)
# NEXT_PUBLIC_GOOGLE_ADS_LABEL_BOOKING=       # booking_started (secondary / observation only)
# NEXT_PUBLIC_GOOGLE_ADS_LABEL_DIRECTIONS=    # directions_click (secondary)
# NEXT_PUBLIC_GOOGLE_ADS_LABEL_NEWSLETTER=    # newsletter_signup (secondary)
# Meta Pixel ID (Events Manager). Loads only after the visitor accepts the banner.
# NEXT_PUBLIC_META_PIXEL_ID=
# PostHog project key and host. Loads only after the visitor accepts the banner.
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Google Consent Mode v2 default before the visitor chooses: "denied" (default) or "granted".
# NEXT_PUBLIC_CONSENT_DEFAULT=denied

# Meta Conversions API (server side, runtime env, NOT public). Needs NEXT_PUBLIC_META_PIXEL_ID too.
# Create a system-user token in Events Manager > Settings > Conversions API; store it in GCP Secret
# Manager. Nothing calls src/lib/meta-capi.ts until the /api/lead owner wires it (see the file header).
# META_CAPI_TOKEN=
# Events Manager > Test events code; while set, events show only in the Test events tab.
# META_CAPI_TEST_EVENT_CODE=
