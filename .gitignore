# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep .env.example tracked)
.env
.env.*
!.env.example

# vercel is retired (TOL-655): keep any stray local link out of git
.vercel/

# typescript
*.tsbuildinfo
next-env.d.ts

# content engine drafts (also covered by /out/ above)
/out/content-drafts/
