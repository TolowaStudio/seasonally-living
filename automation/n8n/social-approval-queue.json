    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst cfg = $('Config').first().json;\nconst p = $json;\nconst s = p.social || {};\nconst problems = [];\nconst text = [s.facebook, s.instagram && s.instagram.caption, s.gbp && s.gbp.text].filter(Boolean).join('\\n');\nif (/\\[\\[|TODO|lorem/i.test(text)) problems.push('Still has an [[ADD]] / TODO placeholder in the social text');\nconst channels = p.channels.length ? p.channels : ['facebook', 'instagram', 'gbp'];\nconst want = (c) => channels.includes(c) && !(p.results && p.results[c === 'gbp' ? 'gbpUrl' : c + 'Url']);\nconst hashtags = ((s.instagram && s.instagram.hashtags) || []).slice(0, 10);\nconst igCaption = ((s.instagram && s.instagram.caption) || '').trim() + (hashtags.length ? '\\n\\n' + hashtags.join(' ') : '');\nif (want('facebook') && !(s.facebook || '').trim()) problems.push('Facebook text is empty');\nif (want('instagram') && !igCaption.trim()) problems.push('Instagram caption is empty');\nif (want('instagram') && igCaption.length > 2200) problems.push('Instagram caption is over 2,200 characters');\nif (want('gbp') && !((s.gbp && s.gbp.text) || '').trim()) problems.push('Google post text is empty');\nif (want('gbp') && s.gbp && s.gbp.text.length > 1500) problems.push('Google post is over 1,500 characters');\nconst img = (t) => 'https://res.cloudinary.com/tolowa-studio/image/upload/' + t + '/' + p.heroImage;\nconst articleUrl = p.hasArticle ? cfg.siteUrl + '/journal/' + p.slug : cfg.siteUrl + '/visit';\nreturn {\n  json: {\n    id: p._id, title: p.title, slug: p.slug, articleUrl, hasArticle: p.hasArticle,\n    problems,\n    wantFacebook: want('facebook'), wantInstagram: want('instagram'), wantGbp: want('gbp'),\n    facebookMessage: (s.facebook || '').trim(), instagramCaption: igCaption,\n    gbpText: ((s.gbp && s.gbp.text) || '').trim(), gbpCta: (s.gbp && s.gbp.cta) || 'LEARN_MORE',\n    imageFacebook: img('f_jpg,q_auto,c_fill,ar_1.91:1,w_1200'),\n    imageInstagram: img('f_jpg,q_auto,c_fill,ar_4:5,w_1080'),\n    imageGbp: img('f_jpg,q_auto,c_fill,ar_4:3,w_1200'),\n    results: p.results || {}, errors: [],\n  },\n};"
      },
