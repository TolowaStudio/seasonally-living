    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst prev = $('Post to Google?').item.json;\nconst res = $json;\nif (res.error || !res.name) return { json: { ...prev, errors: [...prev.errors, 'Google: ' + (res.error && (res.error.message || JSON.stringify(res.error)) || 'no post name returned')] } };\nreturn { json: { ...prev, results: { ...prev.results, gbpUrl: res.searchUrl || ('https://business.google.com/posts/l/' + res.name) } } };"
      },
      "id": "5e1a7c00-0000-4000-8000-000000000035",
      "name": "Google result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3960,
        340
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst r = $json;\nconst failed = r.errors.length > 0 || r.problems.length > 0;\nconst set = {};\nif (r.problems.length) {\n  // Never posted: back to Draft with the reason, so it cannot loop.\n  set['results.lastError'] = 'Not posted: ' + r.problems.join('; ');\n  set.status = 'draft';\n} else {\n  if (r.results.facebookUrl) set['results.facebookUrl'] = r.results.facebookUrl;\n  if (r.results.instagramUrl) set['results.instagramUrl'] = r.results.instagramUrl;\n  if (r.results.gbpUrl) set['results.gbpUrl'] = r.results.gbpUrl;\n  set['results.postedAt'] = new Date().toISOString();\n  set['results.lastError'] = failed ? r.errors.join(' | ') : '';\n  // Success -> published. Any failure -> back to Draft so it can't loop; channels that worked keep their links and are skipped next time.\n  set.status = failed ? 'draft' : 'published';\n}\nreturn { json: { ...r, failed, patch: [\n  { patch: { id: r.id, setIfMissing: { results: {} } } },\n  { patch: { id: r.id, set } },\n] } };"
      },
