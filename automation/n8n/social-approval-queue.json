    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst prev = $('Post to Facebook?').item.json;\nconst res = $json;\nif (res.error || !res.id) return { json: { ...prev, errors: [...prev.errors, 'Facebook: ' + (res.error && (res.error.message || JSON.stringify(res.error)) || 'no post id returned')] } };\nreturn { json: { ...prev, results: { ...prev.results, facebookUrl: 'https://www.facebook.com/' + res.id } } };"
