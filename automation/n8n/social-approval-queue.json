    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst prev = $('Post to Instagram?').item.json;\nconst created = $('Instagram: create media').item.json;\nconst published = $('Instagram: publish media').item.json;\nconst link = $json;\nif (created.error || !created.id) return { json: { ...prev, errors: [...prev.errors, 'Instagram (create): ' + (created.error && (created.error.message || JSON.stringify(created.error)) || 'no media id returned')] } };\nif (published.error || !published.id) return { json: { ...prev, errors: [...prev.errors, 'Instagram (publish): ' + (published.error && (published.error.message || JSON.stringify(published.error)) || 'no media id returned')] } };\n// The photo is live even if the permalink lookup failed; keep a usable link.\nconst url = (link && link.permalink) || 'https://www.instagram.com/';\nreturn { json: { ...prev, results: { ...prev.results, instagramUrl: url } } };"
      },
