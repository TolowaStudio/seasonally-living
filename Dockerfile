# Next.js standalone server for Cloud Run. Cloud Run sets PORT=8080.
FROM node:22.23.1-slim AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG NEXT_PUBLIC_SHOW_COMPS=0
ARG NEXT_PUBLIC_NOINDEX=0
ENV NEXT_PUBLIC_SHOW_COMPS=$NEXT_PUBLIC_SHOW_COMPS NEXT_PUBLIC_NOINDEX=$NEXT_PUBLIC_NOINDEX
# Ads & analytics tags (TOL-3346). All empty = no tag loads. See .env.example.
ARG NEXT_PUBLIC_GA4_ID=
ARG NEXT_PUBLIC_GOOGLE_ADS_ID=
ARG NEXT_PUBLIC_GOOGLE_ADS_LABEL_LEAD=
ARG NEXT_PUBLIC_GOOGLE_ADS_LABEL_PREOWNED=
ARG NEXT_PUBLIC_GOOGLE_ADS_LABEL_CALL=
ARG NEXT_PUBLIC_GOOGLE_ADS_LABEL_BOOKING=
ARG NEXT_PUBLIC_GOOGLE_ADS_LABEL_DIRECTIONS=
ARG NEXT_PUBLIC_GOOGLE_ADS_LABEL_NEWSLETTER=
ARG NEXT_PUBLIC_META_PIXEL_ID=
ARG NEXT_PUBLIC_POSTHOG_KEY=
ARG NEXT_PUBLIC_POSTHOG_HOST=
ARG NEXT_PUBLIC_CONSENT_DEFAULT=
ENV NEXT_PUBLIC_GA4_ID=$NEXT_PUBLIC_GA4_ID NEXT_PUBLIC_GOOGLE_ADS_ID=$NEXT_PUBLIC_GOOGLE_ADS_ID \
    NEXT_PUBLIC_GOOGLE_ADS_LABEL_LEAD=$NEXT_PUBLIC_GOOGLE_ADS_LABEL_LEAD NEXT_PUBLIC_GOOGLE_ADS_LABEL_PREOWNED=$NEXT_PUBLIC_GOOGLE_ADS_LABEL_PREOWNED \
    NEXT_PUBLIC_GOOGLE_ADS_LABEL_CALL=$NEXT_PUBLIC_GOOGLE_ADS_LABEL_CALL NEXT_PUBLIC_GOOGLE_ADS_LABEL_BOOKING=$NEXT_PUBLIC_GOOGLE_ADS_LABEL_BOOKING \
    NEXT_PUBLIC_GOOGLE_ADS_LABEL_DIRECTIONS=$NEXT_PUBLIC_GOOGLE_ADS_LABEL_DIRECTIONS NEXT_PUBLIC_GOOGLE_ADS_LABEL_NEWSLETTER=$NEXT_PUBLIC_GOOGLE_ADS_LABEL_NEWSLETTER \
    NEXT_PUBLIC_META_PIXEL_ID=$NEXT_PUBLIC_META_PIXEL_ID NEXT_PUBLIC_POSTHOG_KEY=$NEXT_PUBLIC_POSTHOG_KEY \
    NEXT_PUBLIC_POSTHOG_HOST=$NEXT_PUBLIC_POSTHOG_HOST NEXT_PUBLIC_CONSENT_DEFAULT=$NEXT_PUBLIC_CONSENT_DEFAULT
RUN npm run build

FROM node:22.23.1-slim
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=8080 HOSTNAME=0.0.0.0
COPY --from=build --chown=node:node /app/.next/standalone ./
COPY --from=build --chown=node:node /app/.next/static ./.next/static
COPY --from=build --chown=node:node /app/public ./public
USER node
EXPOSE 8080
CMD ["node", "server.js"]
